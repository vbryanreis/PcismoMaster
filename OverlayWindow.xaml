<Window x:Class="ResetExplode.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcismoMaster overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Box" Background="#C8000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid x:Name="Root" TextElement.FontFamily="Segoe UI" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5">
            <!-- Formato vertical: tabela com rótulo à esquerda e valor à direita -->
            <StackPanel x:Name="VPanel" MinWidth="200">
                <ItemsControl x:Name="VRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelFg}" FontSize="13" VerticalAlignment="Center" Margin="0,0,24,0"/>
                                <TextBlock Text="{Binding Value}" Foreground="{Binding Fg}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Gráfico de frametime -->
                <Canvas x:Name="OGraph" Height="30" Margin="0,8,0,2" ClipToBounds="True"/>
                <Canvas x:Name="OGraphFps" Height="30" Margin="0,4,0,2" ClipToBounds="True" Visibility="Collapsed"/>
            </StackPanel>
            <!-- Formato horizontal (barra): rótulo pequeno + valor, lado a lado -->
            <ItemsControl x:Name="HRow" Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Label}" Foreground="{Binding LabelFg}" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Value}" Foreground="{Binding Fg}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
